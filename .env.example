# Local development only. Never commit .env or production secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://agency_os:change-me@localhost:5432/agency_os
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=agency-os
DEV_AUTH_ENABLED=true
# Local synthetic worker testing only; remains disabled outside dev/test.
MOCK_RUNTIME_ENABLED=false
CORS_ORIGINS=http://localhost:3000

# Claude Managed Agents is beta and disabled until deliberately configured.
# Use only public/synthetic data until runtime eligibility is verified. The
# Managed Agents adapter remains disabled until the OS MCP bridge and provider
# vault credential lifecycle are configured and tested.
CLAUDE_MANAGED_AGENTS_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2026-10-21
ANTHROPIC_MANAGED_AGENTS_BETA=managed-agents-2026-04-01
CLAUDE_MANAGED_AGENT_ID=
CLAUDE_MANAGED_ENVIRONMENT_ID=
CLAUDE_MANAGED_SESSION_BUDGET_CENTS=250
CLAUDE_MANAGED_TIMEOUT_SECONDS=900
CLAUDE_MANAGED_POLL_INTERVAL_SECONDS=2
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=20

# Agency OS MCP server. Disabled by default; never use wildcard Host allowlists.
# The public URL must be HTTPS and end exactly in /mcp/agency-os.
MCP_GATEWAY_ENABLED=false
MCP_PUBLIC_URL=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_ENABLED_TOOL_KEYS=system.health.read
MCP_SESSION_TOKEN_TTL_SECONDS=900
MCP_REQUESTS_PER_MINUTE=120
MCP_MAX_TOOL_CALLS_PER_SESSION=50
MCP_MAX_REQUEST_BODY_BYTES=65536
MCP_MAX_CONCURRENT_REQUESTS=16

# Telephony is intentionally disabled until a provider adapter, signed webhooks,
# consent/suppression checks, recording policy and provider handlers are verified.
TELEPHONY_PROVIDER=unconfigured
TELEPHONY_ENABLED=false

# Private object storage adapter (not enabled by this bundle).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=agency-os-dev
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Durable transactional outbox delivery
OUTBOX_LEASE_SECONDS=120
OUTBOX_BASE_RETRY_SECONDS=15
OUTBOX_MAX_RETRY_SECONDS=3600

# Optional signed intake from the public agency website. Keep disabled until
# the public site is configured with the matching server-only HMAC secret.
WEBSITE_LEAD_INTAKE_ENABLED=false
WEBSITE_LEAD_INTAKE_SECRET=
WEBSITE_LEAD_INTAKE_KEY_ID=
WEBSITE_LEAD_INTAKE_ORG_ID=
WEBSITE_LEAD_INTAKE_WORKSPACE_ID=
WEBSITE_LEAD_INTAKE_CLOCK_SKEW_SECONDS=300
