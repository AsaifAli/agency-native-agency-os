# Compose interpolation/bootstrap secrets only. Use unique URL-safe random values.
# Example generator: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-strong-bootstrap-superuser-password
POSTGRES_MIGRATOR_PASSWORD=replace-with-strong-migrator-password
POSTGRES_APP_PASSWORD=replace-with-strong-api-password
POSTGRES_WORKER_PASSWORD=replace-with-strong-worker-password

# Copy .env.runtime.example to .env.runtime for API and worker application settings.
# Never put POSTGRES_PASSWORD or MIGRATION_DATABASE_URL in .env.runtime.
