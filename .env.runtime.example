# API/worker runtime settings. Copy to .env.runtime.
# Do not put database-owner, migrator or Postgres bootstrap passwords here.
APP_ENV=development
# Direct local Python run only; Compose overrides this with the API/worker role URL.
DATABASE_URL=sqlite:///./agency_os.db
REDIS_URL=redis://localhost:6379/0

# Development-only values. For production use random 64+ character secrets,
# DEV_AUTH_ENABLED=false, RATE_LIMIT_ENABLED=true and TLS Redis.
JWT_SECRET=unsafe-development-secret-change-me
JWT_KEY_ID=key-current
JWT_PREVIOUS_SECRET=
JWT_PREVIOUS_KEY_ID=key-previous
JWT_ISSUER=agency-os
DEV_AUTH_ENABLED=true
MOCK_RUNTIME_ENABLED=false
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=false
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=5

# Authentik OIDC. Required in production; use the actual public issuer URL.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_STATE_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/callback
OIDC_FRONTEND_URL=http://localhost:3000
OIDC_REQUIRED_ACR=
OIDC_SESSION_COOKIE_NAME=agency_os_session
OIDC_STATE_COOKIE_NAME=agency_os_oidc_state
OIDC_CSRF_COOKIE_NAME=agency_os_csrf
OIDC_SESSION_TTL_SECONDS=1800
BROWSER_SESSION_RETENTION_DAYS=30

# Worker/outbox limits.
WORKER_HEARTBEAT_SHUTDOWN_TIMEOUT_SECONDS=25
WORKER_LEASE_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAINTENANCE_INTERVAL_SECONDS=15
WORKER_MAINTENANCE_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=120
OUTBOX_BASE_RETRY_SECONDS=15
OUTBOX_MAX_RETRY_SECONDS=3600

# Claude Managed Agents remains disabled until account/runtime verification.
CLAUDE_MANAGED_AGENTS_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2026-10-21
ANTHROPIC_MANAGED_AGENTS_BETA=managed-agents-2026-04-01
CLAUDE_MANAGED_AGENT_ID=
CLAUDE_MANAGED_ENVIRONMENT_ID=
CLAUDE_MANAGED_SESSION_BUDGET_CENTS=250
CLAUDE_MANAGED_TIMEOUT_SECONDS=900
CLAUDE_MANAGED_POLL_INTERVAL_SECONDS=2
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=20

# Signed website intake stays disabled until a dedicated secret and fixed scope are configured.
WEBSITE_LEAD_INTAKE_ENABLED=false
WEBSITE_LEAD_INTAKE_SECRET=
WEBSITE_LEAD_INTAKE_KEY_ID=
WEBSITE_LEAD_INTAKE_ORG_ID=
WEBSITE_LEAD_INTAKE_WORKSPACE_ID=
WEBSITE_LEAD_INTAKE_CLOCK_SKEW_SECONDS=300

# Optional integrations remain disabled/unconfigured until their controls are built.
TELEPHONY_PROVIDER=unconfigured
TELEPHONY_ENABLED=false
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=agency-os-dev
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
